{
  "name": "moe-widget",
  "version": "0.1.0",
  "description": "Adorable Live2D characters that live on your web pages.",
  "keywords": [
    "live2d",
    "cubism",
    "webgl",
    "react",
    "vtuber",
    "widget"
  ],
  "license": "MIT",
  "author": "Meoki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meokisama/moe-widget.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "scripts": {
    "dev": "vite playground",
    "build:playground": "vite build playground",
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "sync-cubism": "node scripts/sync-cubism.mjs",
    "preversion": "npm run check && npm test && npm run build",
    "release:patch": "npm version patch -m \"chore: release %s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"chore: release %s\" && git push --follow-tags",
    "release:major": "npm version major -m \"chore: release %s\" && git push --follow-tags"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsdown": "^0.15.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
